  "composicao": {
   "description": "Composição por página (references/09-composicao.md), escrita ANTES de buscar ou gerar elementos. Chave = rótulo da página: tipo ('ativo', 'cota': vale como gramática do tipo), variante ('cota:b'), página ('ativo:2', 'cota:Master') ou 'vertical:capa|numeros|contato'. O mais específico vence.",
   "type": "object",
   "propertyNames": {
    "pattern": "^(_.*|[a-z_]+(:[^\\s]+)?)$"
   },
   "additionalProperties": {
    "$ref": "#/definitions/composicao_pagina"
   }
  },
  "composicao_pagina": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "mensagem": {
     "type": "string",
     "minLength": 3,
     "maxLength": 200,
     "description": "o que a página diz, numa frase"
