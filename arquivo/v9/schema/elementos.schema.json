    "acabamento": {
     "type": "object",
     "additionalProperties": false,
     "description": "opcional (mk-2.1): a camada de acabamento desta página (references/10-acabamento.md). Vence direcao_criativa.intensidade.padrao",
     "properties": {
      "recursos": {
