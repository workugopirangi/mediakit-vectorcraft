    "direcao_criativa": {
      "type": "object",
      "additionalProperties": false,
      "description": "opcional (mk-2.1): a direção da camada de acabamento do kit inteiro (references/10-acabamento.md). Sem ela o kit renderiza como antes. As regras além do schema (família proibida usada, fio condutor curto, teto abaixo do padrão, poucas famílias) estão em pipeline/acabamento.py.",
      "properties": {
        "consulta": {
          "type": "string",
          "description": "caminho relativo à pasta do kit do registro da consulta ao repertório (consulta-repertorio.json)"
        },
        "recursos": {
          "type": "array",
          "minItems": 0,
          "maxItems": 9,
          "description": "os recursos de acabamento escolhidos para o kit; páginas e elementos citam o `id`",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "familia",
              "referencia",
              "principio",
              "rota"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "familia": {
                "enum": [
                  "ornamento-identidade",
                  "pattern-textura",
                  "sobreposicao-recorte",
                  "profundidade-3d",
                  "tratamento-imagem",
                  "tipografia-expressiva",
                  "acabamento-borda",
                  "composicao-hibrida"
                ]
              },
              "referencia": {
                "type": "string",
                "description": "de onde veio: id do repertório ou da consulta"
              },
              "principio": {
                "type": "string",
                "minLength": 8,
                "description": "a relação copiada da referência, nunca a forma"
              },
              "rota": {
                "enum": [
                  "codigo",
                  "imagem",
                  "hibrido"
                ]
              },
              "motivo": {
                "type": "string",
                "description": "id de sistema_elementos.motivos"
              },
              "nao_copiar": {
                "type": "string",
                "description": "o que da referência fica de fora"
              }
            }
          }
        },
        "nao_usa": {
          "type": "array",
          "description": "famílias proibidas neste kit: página que usa recurso de uma delas é FALHA",
          "items": {
            "enum": [
              "ornamento-identidade",
              "pattern-textura",
              "sobreposicao-recorte",
              "profundidade-3d",
              "tratamento-imagem",
              "tipografia-expressiva",
              "acabamento-borda",
              "composicao-hibrida"
            ]
          }
        },
        "intensidade": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "padrao",
            "teto"
          ],
          "description": "0 nenhuma, 1 sutil, 2 presente, 3 marcante; `acabamento.intensidade` da página vence o padrão",
          "properties": {
            "padrao": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "teto": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "fio_condutor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motivo",
            "papeis"
          ],
          "description": "o motivo que atravessa o kit e o papel dele em cada página (rótulo de página, como em `composicao`)",
          "properties": {
            "motivo": {
              "type": "string"
            },
            "papeis": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "contrapeso",
                  "selo",
                  "separador",
                  "estrutura",
                  "eco",
                  "textura",
                  "moldura"
                ]
              }
            }
          }
        },
        "repete_entre_paginas": {
          "type": "array",
          "description": "ids de recurso que repetem do mesmo jeito entre páginas (a unidade do kit)",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "formato_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versao",
        "sha256"
      ],
      "description": "opcional (mk-2.1): o formato de que o kit partiu, com versão e o sha256 do arquivo do formato. O que o kit declara vence o formato.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "versao": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
