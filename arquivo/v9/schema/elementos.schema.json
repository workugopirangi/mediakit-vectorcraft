        "nenhum",
        "leve",
        "padrao",
        "forte"
       ]
      },
      "luz": {
       "enum": [
        "nenhuma",
        "esq",
        "dir",
        "topo"
       ]
      },
      "porque": {
       "type": "string",
       "minLength": 8
      }
     }
    },
    "elementos": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/composicao_elemento"
     }
