  "composicao_elemento": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "papel",
    "funcao",
    "ancora"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "grafismo": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "tipo"
     ],
     "properties": {
      "tipo": {
       "type": "string"
      },
      "params": {
       "type": "object"
      }
     },
     "description": "grafismo por código declarado só nesta página (id sem entrada em elementos[])"
    },
    "papel": {
     "enum": [
      "heroi",
      "apoio",
      "estrutura",
      "acabamento"
     ],
     "description": "'acabamento' (mk-2.1): exige `motivo` (dele ou do elemento em elementos[]) e função acabamento, identidade, profundidade ou equilibrio; no máximo 2 por página"
    },
    "recurso": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$",
     "description": "opcional (mk-2.1): id de direcao_criativa.recursos que este elemento realiza"
    },
    "motivo": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$",
     "description": "opcional (mk-2.1): id de sistema_elementos.motivos; vence o `motivo` do elemento em elementos[]"
    },
    "efeito": {
     "type": "object",
     "additionalProperties": false,
     "description": "opcional (mk-2.1): efeitos de acabamento deste elemento nesta página. Vence elementos[].opacidade e .blend, que vencem o tema. Regras além do schema em pipeline/acabamento.py (sombra contato e reflexo piso só em PNG de imagem, sombra deslocada só em grafismo SVG, cruza só na camada frente)",
     "properties": {
      "opacidade": {
       "enum": [
        1,
        0.72,
        0.46,
        0.24,
        0.12,
        0.06
       ]
      },
      "blend": {
       "enum": [
        "normal",
        "multiply",
        "screen",
        "soft-light"
       ]
      },
      "mascara": {
       "enum": [
        "nenhuma",
        "diagonal",
        "chanfro",
        "circulo",
        "arco-base",
        "janela"
       ]
      },
      "sombra": {
       "enum": [
        "nenhuma",
        "contato",
        "deslocada"
       ]
      },
      "reflexo": {
       "enum": [
        "nenhum",
        "piso"
       ]
      },
      "cruza": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "alvo",
        "corte"
       ],
       "description": "o elemento cruza o texto do alvo: o render o parte na linha `corte` do alvo, um pedaço atrás do texto e outro na frente (dois nós do mesmo PNG)",
       "properties": {
        "alvo": {
         "enum": [
          "titulo",
          "numero"
         ]
        },
        "corte": {
         "enum": [
          "linha_base",
          "cap",
          "cy"
         ]
        }
       }
      },
      "esmaecer": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "direcao",
        "passos",
        "minimo"
       ],
       "description": "a tinta perde força em degraus na direção dada, até a opacidade `minimo`",
       "properties": {
        "direcao": {
         "enum": [
          "dir",
          "esq",
          "cima",
          "baixo"
         ]
        },
        "passos": {
         "type": "integer",
         "minimum": 3,
         "maximum": 8
        },
        "minimo": {
         "type": "number",
         "minimum": 0,
         "maximum": 0.46
        }
       }
      }
     }
    },
    "funcao": {
     "enum": [
      "foco",
      "contexto",
      "identidade",
      "conexao",
      "organizacao",
      "profundidade",
      "equilibrio",
      "acabamento"
     ]
    },
    "camada": {
     "enum": [
      "atras",
      "frente",
      "sob-veu"
     ]
    },
    "ancora": {
     "$ref": "#/definitions/composicao_ancora"
    },
    "escala": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "altura": {
       "type": [
        "string",
        "number"
       ],
       "pattern": "^((1/6|1/4|1/3|1/2|2/3|3/4|1)p|[1-9][0-9]?col|[1-9]cap)$"
      },
      "largura": {
       "type": [
        "string",
        "number"
       ],
       "pattern": "^((1/6|1/4|1/3|1/2|2/3|3/4|1)p|[1-9][0-9]?col|[1-9]cap)$"
      },
      "de": {
       "type": "string"
      }
     }
    },
    "proporcao": {
     "type": "array",
     "items": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "[w, h] do asset ainda não gerado: a maquete (render.py --maquete) desenha a caixa nesta proporção no lugar resolvido; o render final reprova enquanto o asset não existir"
    },
    "rot": {
     "type": "number",
     "minimum": -180,
     "maximum": 180
    },
    "espelhar": {
     "type": "boolean"
    },
    "porque": {
     "type": "string",
     "minLength": 8
    }
   }
  },
