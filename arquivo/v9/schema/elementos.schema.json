       "type": "string"
      },
      "lado": {
       "enum": [
        "esq",
        "dir",
        "topo",
        "base"
       ]
      },
      "fracao": {
       "enum": [
        "1/4",
        "1/3",
        "1/2"
       ]
      },
      "x": {
       "type": "string",
       "pattern": "^(esq|dir|cx|topo|base|cy|linha_base|cap)=[a-z][a-z0-9-]*(:[A-Za-z0-9_À-ÿ-]+)?(\\.l[0-9]+)?\\.(esq|dir|cx|topo|base|cy|linha_base|cap)([+-](e[1-8]|[0-9]+(\\.[0-9]+)?))?$"
      },
      "y": {
       "type": "string",
       "pattern": "^(esq|dir|cx|topo|base|cy|linha_base|cap)=[a-z][a-z0-9-]*(:[A-Za-z0-9_À-ÿ-]+)?(\\.l[0-9]+)?\\.(esq|dir|cx|topo|base|cy|linha_base|cap)([+-](e[1-8]|[0-9]+(\\.[0-9]+)?))?$"
      }
     }
    },
    {
